                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Request denied or configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenant-policy/email": {
      "get": {
        "description": "Read authenticated organization email authority.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current effective mode, configuredMode and opaque version"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient authority"
          },
          "409": {
            "description": "Stale version; reload"
          },
          "503": {
            "description": "Policy unavailable"
          }
        }
      },
      "post": {
        "description": "Save mode with current opaque version. Requires organization owner/admin in HyperFlow, or tenant:policy:manage plus communications:write in Communications.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current effective mode, configuredMode and opaque version"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient authority"
          },
          "409": {
            "description": "Stale version; reload"
          },
          "503": {
            "description": "Policy unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mode",
                  "version"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "draft_only",
                      "allow_send"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
