# Required. The process exits without it.
OPENAI_API_KEY=sk-proj-xxx

# Listen port. Defaults to 5050.
# PORT=5050

# --- Persistence: choose Supabase or direct PostgreSQL ----------------------
# Replit Database is PostgreSQL. After adding a database to the Replit app,
# Replit supplies DATABASE_URL; select postgres and run `npm run db:migrate`.
# PERSISTENCE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host/database
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
#
# Existing Supabase deployments remain supported. Select Supabase explicitly,
# or retain SUPABASE_CONFIG_ENABLED=true for backward compatibility.
# PERSISTENCE_PROVIDER=supabase
#
# Config resolves in this order: the other party's contact_config row (the
# caller inbound, the callee outbound), then phone_configs for one of our
# lines, then DEFAULT_CONFIG in config.js.
#
# contacts, contact_config and calls have RLS enabled — the anon key returns
# nothing at all, so the service-role key is required.
SUPABASE_CONFIG_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Auth and providers (/v1, /api, /outbound-call, /sms) --------------------
# API_KEY is the shared secret callers send as the X-API-Key header. If it is
# unset, protected routes return 503 rather than running unprotected.
API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public base URL Twilio can reach this server on — your ngrok or Replit URL.
# Used to build the /outbound-answer and /call-status callbacks, so outbound
# calls cannot be placed without it, and to verify webhook signatures.
PUBLIC_URL=https://your-app.replit.app

# --- Twilio webhook signatures ----------------------------------------------
# off | warn | enforce. Defaults to "enforce" when TWILIO_AUTH_TOKEN is set and
# "off" when it is not.
#
# "warn" runs the whole check and logs the verdict without rejecting anything,
# because validation depends on PUBLIC_URL matching the URL Twilio signed byte
# for byte — a proxy or a trailing slash breaks it silently, and going straight
# to "enforce" on a bad value rejects every real call. Place a call, confirm no
# "would have been rejected" lines, then switch.
# TWILIO_VALIDATE_SIGNATURES=enforce

# --- Call latency ------------------------------------------------------------
# Set to "false" to go back to opening the OpenAI Realtime socket when the media
# stream starts, instead of when the TwiML webhook answers. On by default: the
# handshake is the single largest thing a caller waits through before hearing a
# word, and starting it earlier overlaps it with Twilio setting up the stream.
# The media stream falls back to connecting for itself whenever there is no
# session to adopt, so turning this off changes timing and nothing else.
# PRECONNECT_REALTIME=true

# --- Tools -------------------------------------------------------------------
# Endpoint for each http-type tool in tools.js, named TOOL_<NAME>_URL. A tool
# whose URL is unset is treated as unavailable and is never offered to the
# model, so leaving this blank simply means the assistant cannot check a
# calendar. Builtin tools (get_current_time) need no configuration.
# TOOL_CHECK_CALENDAR_URL=

# --- Transcription -----------------------------------------------------------
# Model used to transcribe a recording. Defaults to gpt-4o-transcribe-diarize,
# the only one that returns speaker labels; anything else loses attribution.
# TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize

# Model used to summarise a finished transcript. Small on purpose — this is
# compression, not reasoning, and it runs after every call.
# SUMMARY_MODEL=gpt-5.4-mini

# Model used by the asynchronous communications memory worker for structured
# summaries, current state, commitments and facts. Defaults to SUMMARY_MODEL.
# MEMORY_MODEL=gpt-5.4-mini

# Nearby calendar events are returned as candidates rather than auto-linked.
# The default participant/time window is 120 minutes.
# CALENDAR_CANDIDATE_WINDOW_MINUTES=120

# Optional explainable search tuning.
# MEMORY_SEARCH_TEXT_WEIGHT=0.65
# MEMORY_SEARCH_PROJECT_BOOST=0.10
# MEMORY_SEARCH_PERSON_BOOST=0.10
# MEMORY_SEARCH_THREAD_BOOST=0.05
# MEMORY_SEARCH_CALENDAR_BOOST=0.05
# MEMORY_SEARCH_RECENCY_BOOST=0.05

# Optional per-source host allow-list for POST /api/recordings, e.g.
# RECORDING_SOURCE_PLAUD_HOSTS=api.plaud.ai,cdn.plaud.ai
# Fixed bearer credential used only when ingest sets useProviderAuth=true.
# RECORDING_SOURCE_PLAUD_TOKEN=
# Without it, any public https host is accepted; private and reserved ranges are
# rejected either way.

# --- Durable Communications events -----------------------------------------
# Optional default destination for communication, SMS, call, transcript,
# summary and Ask-response events. Delivery is persisted in outbound_events and
# retried with exponential backoff; it is never a one-shot fetch.
# HYPERFLOW_EVENT_URL=https://hyperflow.example.com/api/communications/events

# Required HMAC secret when a destination is configured. Deliveries include
# X-Communications-Signature: sha256=<hex digest of the raw JSON body>.
# COMMUNICATIONS_WEBHOOK_SECRET=
# Optional destination host allow-list; every redirect is checked too.
# COMMUNICATIONS_WEBHOOK_HOSTS=hyperflow.example.com
