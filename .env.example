OPENAI_API_KEY=sk-proj-xxx

# --- Per-call config from Supabase (public.phone_configs) -------------------
# Rows are keyed by phone number in E.164. On an inbound call the caller's row
# wins, else the row for the number they dialled, else the built-in defaults.
# Leave SUPABASE_CONFIG_ENABLED unset or false to always use the defaults.
SUPABASE_CONFIG_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Outbound calls (POST /outbound-call) -----------------------------------
# All four are required; without them the endpoint returns 503 and no call can
# be placed. API_KEY is the shared secret callers send as the X-API-Key header.
API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public base URL Twilio can reach this server on, e.g. your ngrok or Replit URL.
PUBLIC_URL=https://your-app.replit.app
