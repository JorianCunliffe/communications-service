        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "operation",
                  "keyId"
                ],
                "properties": {
                  "operation": {
                    "enum": [
                      "create",
                      "rotate",
                      "revoke"
                    ]
                  },
                  "keyId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{8,80}$"
                  },
                  "revision": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "secret": {
                    "type": "string",
                    "writeOnly": true,
                    "minLength": 32,
                    "maxLength": 256
                  },
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "admin",
                        "reader",
                        "writer"
                      ]
                    }
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "description": "Administrator plus tenant:manage and communications read/write capabilities required. Creation delegates only supported caller capabilities to one tenant. Rotate/revoke require current client revision. Identical create/rotate replay is safe; revoked clients cannot be reactivated. Caller supplies and retains the secret; responses omit secrets and hashes."
              }
            }
          }
        }
      }
    },
