                }
              }
            }
          }
        }
      }
    },
    "/v1/emails": {
      "post": {
        "description": "Requires authenticated tenant, communications:write and email:send (or wildcard). Email also requires tenant ceiling permission. Existing payload contract in API_REFERENCE.md.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Tenant-Id",
            "schema": {
              "type": "string"
            },
            "description": "Required for named API clients; validated against allowed_tenants."
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted operation; inspect canonical communication for outcome"
          },
          "403": {
            "description": "Request denied or configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
